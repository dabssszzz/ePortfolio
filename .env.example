# ==========================================
# Engelbert Morales Portfolio - Environment Configuration
# ==========================================
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with secrets to Git.

# Server Port
PORT=3001

# Destination Email where contact messages will be delivered
CONTACT_EMAIL=engelbert17dm@gmail.com

# Verified Sender Email (e.g. from your domain or Resend default)
EMAIL_FROM=Engelbert Portfolio <onboarding@resend.dev>

# ------------------------------------------
# OPTION A: RESEND API (Recommended - Modern & Fast)
# ------------------------------------------
# Sign up at https://resend.com and grab your API key
RESEND_API_KEY=

# ------------------------------------------
# OPTION B: SMTP CREDENTIALS (Gmail, SendGrid, Mailgun, Custom)
# ------------------------------------------
# If RESEND_API_KEY is not set, the server will use SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------
# SECURITY & CORS
# ------------------------------------------
# Frontend origin(s) allowed to communicate with the API (comma-separated if multiple)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting: Maximum submissions per window per IP
RATE_LIMIT_MAX=5
# Rate Limiting: Time window in minutes
RATE_LIMIT_WINDOW_MINUTES=15
